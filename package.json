{
  "name": "vicflora-offline",
  "version": "1.0.0",
  "description": "Offline PWA and data importers for VicFlora dichotomous and multi-access keys",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node main.js",
    "scrape:multi": "node main.js multi-access",
    "scrape:identification": "node main.js identification",
    "scrape:all": "node main.js all",
    "scrape:keybase": "node keybase-scraper-simple.js keybase-list.html keybase-data",
    "list": "node main.js list",
    "fetch:photos": "node scripts/fetch-photos.js",
    "build:web": "node scripts/build-web-data.js",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "vicflora",
    "botanical",
    "keys",
    "scraping",
    "taxonomy",
    "flora"
  ],
  "author": "",
  "license": "MIT"
}
